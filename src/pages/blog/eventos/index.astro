---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../../components/FormattedDate.astro';

const posts = (await getCollection('blog'))
	.filter(p => {
	console.log(p); 
	return p.data.tags.includes("event")
	})
	.sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="max-w-7xl mx-auto py-24 px-4 text-center">
			<p class="my-4">
         Você também pode acompanhar nossos eventos pelo <a class="text-pink-400 underline" href="https://www.meetup.com/opensanca/" target="_blank">Meetup</a>
			</p>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li class="flex justify-center">
								<a href={`/blog/${post.id}/`}>
									<img width={720} height={360} src={post.data.heroImage} alt="" />
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
