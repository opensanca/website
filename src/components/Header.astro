---
import Opensanca from '../components/icons/Opensanca.astro'
import Bars from '../components/icons/Bars.astro'
---

<header>
  <div class="navbar fixed top-0 z-50 bg-base-100 shadow">
    <div class="container mx-auto flex justify-between items-center w-full">
      <!-- Logo and brand -->
      <div class="flex items-center gap-2">
        <a href="#page-top" class="flex items-center gap-2">
          <Opensanca className="size-8" />
          <span class="font-light text-xl">Opensanca</span>
        </a>
      </div>

      <!-- Desktop menu -->
      <ul class="menu menu-horizontal hidden md:flex px-1">
        <li><a href="#about">Sobre</a></li>
        <li><a href="https://www.meetup.com/opensanca/" target="_blank">Eventos</a></li>
        <li><a href="https://github.com/opensanca" target="_blank">Projetos</a></li>
        <li><a href="#podcast">Podcast</a></li>
        <li><a href="#contact">Contato</a></li>
        <li class="flex flex-row gap-1 items-center">
          ☀️
          <input type="checkbox" value="dark" class="toggle theme-controller" />
          🌕
        </li>
      </ul>

      <!-- Mobile menu button -->
      <div class="dropdown dropdown-end md:hidden">
        <button tabindex="0" class="btn btn-ghost">
          <Bars className="size-6"
        </button>
        <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-10 p-2 shadow bg-base-100 rounded-box w-52">
          <li><a href="#about">Sobre</a></li>
          <li><a href="https://www.meetup.com/opensanca/" target="_blank">Eventos</a></li>
          <li><a href="https://github.com/opensanca" target="_blank">Projetos</a></li>
          <li><a href="#podcast">Podcast</a></li>
          <li><a href="#contact">Contato</a></li>
        </ul>
      </div>
    </div>
  </div>
</header>
