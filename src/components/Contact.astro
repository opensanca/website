---
import Xwitter from '../components/icons/Slack.astro'
import Facebook from '../components/icons/Facebook.astro'
import Youtube from '../components/icons/Youtube.astro'
import Github from '../components/icons/Github.astro'
import Instagram from '../components/icons/Instagram.astro'
import Medium from '../components/icons/Medium.astro'
import Linkedin from '../components/icons/Linkedin.astro'
---
<section id="contact" class="py-16 bg-base-100 text-center">
  <div class="max-w-3xl mx-auto px-4">
    <h2 class="text-4xl font-bold mb-4">Faça contato!</h2>
    <p class="mb-8 text-lg">
      <a href="mailto:opensanca@gmail.com" class="link link-info">
        opensanca@gmail.com
      </a>
    </p>
    <ul class="flex flex-wrap justify-center gap-4">
      <li>
        <a
          href="https://twitter.com/opensanca"
          class="btn btn-outline"
          target="_blank"
        >
          <Xwitter className="size-6" /> Xwitter
        </a>
      </li>
      <li>
        <a
          href="https://github.com/opensanca"
          class="btn btn-outline"
          target="_blank"
        >
          <Github className="size-6" /> Github
        </a>
      </li>
      <li>
        <a
          href="https://www.facebook.com/groups/398166953717267/"
          class="btn btn-outline"
          target="_blank"
        >
          <Facebook className="size-6" /> Facebook
        </a>
      </li>
      <li>
        <a
          href="https://www.youtube.com/c/opensanca"
          class="btn btn-outline"
          target="_blank"
        >
          <Youtube className="size-6" /> Youtube
        </a>
      </li>
      <li>
        <a
          href="https://medium.com/opensanca"
          class="btn btn-outline"
          target="_blank"
        >
          <Medium className="size-6" /> Medium
        </a>
      </li>
      <li>
        <a
          href="https://www.linkedin.com/company/opensanca/"
          class="btn btn-outline"
          target="_blank"
        >
          <Linkedin className="size-6" /> Linkedin
        </a>
      </li>
      <li>
        <a
          href="https://www.instagram.com/opensanca/"
          class="btn btn-outline"
          target="_blank"
        >
          <Instagram className="size-6" /> Instagram
        </a>
      </li>
    </ul>
  </div>
</section>
