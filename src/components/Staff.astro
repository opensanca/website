---
import { Image } from 'astro:assets';

import Cristofer from '../assets/cristofersousa.jpg';
import Deyse from '../assets/deyse_sande.jpg';
import Carlos from '../assets/carlos_ribeiro.jpeg';
import Marcelo from '../assets/marcelomikymine.jpg';
import Leticia from '../assets/leticiarostirola.jpeg';
import Andre from '../assets/andreluisgomes.jpeg';
import Rafael from '../assets/rafaelpereira.jpeg';
import Paula from '../assets/paulamilani.jpeg';
import Samuel from '../assets/samuelgrigolato.jpeg';
import Davi from '../assets/davi.jpg';
import Vitor from '../assets/vitorruschoni.jpeg';
import Leonardo from '../assets/leonardoalvezmiguel.jpeg';
import Marcel0ll from '../assets/marcel0ll.jpeg';
import Alex from '../assets/alex.jpeg';
---

<section id="staff" class="py-16 text-center bg-[#6f5499]">
  <div class="max-w-7xl mx-auto px-4">
    <h1 class="text-4xl font-bold mb-4">Gente que faz acontecer!</h1>
    <p class="text-lg mb-12">
      Sem essas pessoas, isso aqui não sairia do papel, em meio a um
      "Toró de Parpite" surge o
      <strong class="text-info">OPENSANCA! <i class="fa fa-heart text-red-500"></i></strong>
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-10">
      <a href="https://br.linkedin.com/in/cristofersousa" target="_blank" class="flex flex-col items-center">
        <Image src={Cristofer} class="rounded-full w-32 h-32 object-cover mb-4" alt="Cristofer Sousa" />
        <h5 class="font-semibold">Cristofer Sousa</h5>
      </a>

      <a href="https://br.linkedin.com/in/deyse-sande-8975a311/pt" target="_blank" class="flex flex-col items-center">
        <Image src={Deyse} class="rounded-full w-32 h-32 object-cover mb-4" alt="Deyse Sande" />
        <h5 class="font-semibold">Deyse Sande</h5>
      </a>

      <a href="https://br.linkedin.com/in/carloseduribeiro" target="_blank" class="flex flex-col items-center">
        <Image src={Carlos} class="rounded-full w-32 h-32 object-cover mb-4" alt="Carlos Ribeiro" />
        <h5 class="font-semibold">Carlos Ribeiro</h5>
      </a>

      <a href="https://www.linkedin.com/in/marcelomiky" target="_blank" class="flex flex-col items-center">
        <Image src={Marcelo} class="rounded-full w-32 h-32 object-cover mb-4" alt="Marcelo Miky Mine" />
        <h5 class="font-semibold">Marcelo Miky Mine</h5>
      </a>

      <a href="https://www.linkedin.com/in/lrostirola/" target="_blank" class="flex flex-col items-center">
        <Image src={Leticia} class="rounded-full w-32 h-32 object-cover mb-4" alt="Leticia Rostirola" />
        <h5 class="font-semibold">Leticia Rostirola</h5>
      </a>

      <a href="https://www.linkedin.com/in/andreluisgomes/" target="_blank" class="flex flex-col items-center">
        <Image src={Andre} class="rounded-full w-32 h-32 object-cover mb-4" alt="André Luis Gomes" />
        <h5 class="font-semibold">André Luis Gomes</h5>
      </a>

      <a href="https://www.linkedin.com/in/girolineto/" target="_blank" class="flex flex-col items-center">
        <Image src={Rafael} class="rounded-full w-32 h-32 object-cover mb-4" alt="Rafael Pereira Girolineto" />
        <h5 class="font-semibold">Rafael Pereira Girolineto</h5>
      </a>

      <a href="https://www.linkedin.com/in/paula-milani-917ab365/" target="_blank" class="flex flex-col items-center">
        <Image src={Paula} class="rounded-full w-32 h-32 object-cover mb-4" alt="Paula Milani" />
        <h5 class="font-semibold">Paula Milani</h5>
      </a>

      <a href="https://www.linkedin.com/in/samuel-grigolato" target="_blank" class="flex flex-col items-center">
        <Image src={Samuel} class="rounded-full w-32 h-32 object-cover mb-4" alt="Samuel Grigolato" />
        <h5 class="font-semibold">Samuel Grigolato</h5>
      </a>

      <a href="https://www.linkedin.com/in/daviguelfi/" target="_blank" class="flex flex-col items-center">
        <Image src={Davi} class="rounded-full w-32 h-32 object-cover mb-4" alt="Davi Erba" />
        <h5 class="font-semibold">Davi Erba</h5>
      </a>

      <a href="https://www.linkedin.com/in/ruschoni02/" target="_blank" class="flex flex-col items-center">
        <Image src={Vitor} class="rounded-full w-32 h-32 object-cover mb-4" alt="Vitor Ruschoni" />
        <h5 class="font-semibold">Vitor Ruschoni</h5>
      </a>

      <a href="https://www.linkedin.com/in/leonardoalvesmiguel/" target="_blank" class="flex flex-col items-center">
        <Image src={Leonardo} class="rounded-full w-32 h-32 object-cover mb-4" alt="Leonardo Alves Miguel" />
        <h5 class="font-semibold">Leonardo Alves Miguel</h5>
      </a>

      <a href="https://marceloll.com/" target="_blank" class="flex flex-col items-center">
        <Image src={Marcel0ll} class="rounded-full w-32 h-32 object-cover mb-4" alt="Marcelo L. Lotufo" />
        <h5 class="font-semibold">Marcelo L. Lotufo</h5>
      </a>

      <a href="https://www.linkedin.com/in/alexcortesdesign/" target="_blank" class="flex flex-col items-center">
        <Image src={Alex} class="rounded-full w-32 h-32 object-cover mb-4" alt="Alex" />
        <h5 class="font-semibold">Alex</h5>
      </a>
    </div>
  </div>
</section>
